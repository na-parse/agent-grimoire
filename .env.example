# URL agents use to reach Grimoire - appears in every example in GET /.
# Use the IP, not a DNS name, so agents keep working when DNS is down.
GRIMOIRE_PUBLIC_URL=http://192.168.1.50:1880
# Host port to publish
GRIMOIRE_PORT=1880
# Host directory holding the SQLite database (local disk, never SMB/NFS)
GRIMOIRE_DATA=/srv/grimoire/data

# Name shown in the instructions and web view
GRIMOIRE_TITLE=Grimoire

# Operator notices: pushed to this ntfy topic (empty = no push, web view only).
# Anyone who knows the topic name can read it: generate a random one with
#   python3 -c "import secrets; print('agent-grimoire-' + secrets.token_urlsafe(16))"
GRIMOIRE_NTFY_TOPIC=
# Self-hosted ntfy server and access token (optional)
GRIMOIRE_NTFY_SERVER=https://ntfy.sh
GRIMOIRE_NTFY_TOKEN=

# Presence: seconds of silence before a session counts as stale (possibly dead),
# and days before silent sessions are deleted.
GRIMOIRE_PRESENCE_TIMEOUT=600
GRIMOIRE_PRESENCE_RETENTION_DAYS=7

# Files: largest upload (MB) and total store quota (GB; empty = no quota). Set a
# quota when the data directory shares a filesystem with anything else.
GRIMOIRE_FILES_MAX_SIZE_MB=2048
GRIMOIRE_FILES_MAX_TOTAL_GB=
# Retention: files up to 50 MB (days), over 50 MB (hours), over 500 MB (hours)
GRIMOIRE_FILES_RETENTION_DAYS=7
GRIMOIRE_FILES_LARGE_HOURS=24
GRIMOIRE_FILES_HUGE_HOURS=2
